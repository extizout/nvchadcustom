{
  "apim protocol": {
    "prefix": "pt",
    "body": [
      "{",
      "    \"protocol\": \"HTTP\",",
      "    \"method\": \"${1:GET}\",",
      "    \"url\": \"/${2} ?'@FUNC.urlQueryString()'\",",
      "    \"commandName\": \"${3}\",",
      "    \"channel\": \"API\",",
      "    \"nodeName\": \"APIM\",",
      "    \"redirectStep\": \"@TABLE.validateCommand.vc_${3}\"",
      "}",
      ""
    ],
    "description": "apim protocol"
  },
  "apim validate command": {
    "prefix": "vc",
    "body": [
      "{",
      "    \"${1:${TM_FILENAME_BASE}}\": {",
      "        \"verify\": {",
      "            \"mandatory\": {",
      "                \"header\": [",
      "                    \"Content-Type\",",
      "                    \"${2:transaction}\"",
      "                ],",
      "                \"body\": [",
      "                   \"${3}\"",
      "                ]",
      "            },",
      "            \"validate\": {}",
      "        },",
      "        \"variable\": {",
      "            \"@VAR.modelName\": \"${4}\",",
      "            \"@VAR.status\": 403,",
      "            \"@VAR.code\": \"40300\",",
      "            \"@VAR.reason\": \"Missing or invalid parameter\",",
      "            \"@VAR.uri\": \"@FUNC.getUrl()\"",
      "        },",
      "        \"loglist\": {},",
      "        \"conditionResponse\": {",
      "            \"verifySuccess\": {",
      "                \"redirectCommand\": [",
      "                    \"@TABLE.command.cm_getProfile\",",
      "                    \"${5:@TABLE.command.cm_}\"",
      "                ],",
      "                \"end\": \"${6:@TABLE.condition.cd_}.success\"",
      "            },",
      "            \"verifyError\": {",
      "                \"verifyMandatory\": {",
      "                    \"redirectStep\": \"${7:@TABLE.condition.cd_}.error\"",
      "                },",
      "                \"verifyValidate\": {",
      "                    \"redirectStep\": \"${7:@TABLE.condition.cd_}.erro\"",
      "                }",
      "            }",
      "        }",
      "    }",
      "}",
      ""
    ],
    "description": "apim validate command"
  },
  "apim init condition": {
    "prefix": "icd",
    "body": [
      "{",
      "    \"${1:${TM_FILENAME_BASE}}\": {",
      "        \"${2}\": [",
      "            {",
      "                \"variable\": {",
      "                   \"@VAR.${4}\": \"${5}\"",
      "                },",
      "                \"criteria\": {",
      "                    \"action\": \"custom\",",
      "                    \"value\": \"'${3}'\"",
      "                },",
      "                \"redirectStep\": \"@TABLE.condition.cd_${6}\"",
      "            }",
      "        ]",
      "    }",
      "}"
    ],
    "description": "apim init condition"
  },
  "apim sub condition": {
    "prefix": "cd",
    "body": [
      "            {",
      "                \"variable\": {",
      "                   \"@VAR.${4}\": \"${5}\"",
      "                },",
      "                \"criteria\": {",
      "                    \"action\": \"custom\",",
      "                    \"value\": \"'${3}'\"",
      "                },",
      "                \"redirectStep\": \"@TABLE.condition.${6:${TM_FILENAME_BASE}}\"",
      "            }"
    ],
    "description": "apim sub condition"
  },
  "apim command": {
    "prefix": "cm",
    "body": [
      "{",
      "    \"${1:${TM_FILENAME_BASE}}\": {",
      "        \"send\": {",
      "            \"destNode\": \"${2}\",",
      "            \"destHost\": \"@CONFIG.custom.${3:baseUrlKey}.endpoint\",",
      "            \"protocol\": \"@CONFIG.custom.${3}.protocol\",",
      "            \"redirectURL\": \"'CONFIG.custom.${3}.${4:resouceKey}.uri'\",",
      "            \"method\": \"@CONFIG.custom.${3}.${4}.method\",",
      "            \"contentType\": \"@CONFIG.custom.${3}.${4}.contentType\",",
      "            \"timeout\": \"@CONFIG.custom.${3}.${4}.timeout\",",
      "            \"retryLimit\": \"0\",",
      "            \"setParameter\": [",
      "                {",
      "                    \"@PARAM.header\": {",
      "                        \"Content-Type\": \"@CONFIG.custom.${3}.${4}.contentType\"",
      "                    }",
      "                }",
      "            ],",
      "            \"header\": \"@PARAM.header\",",
      "            \"body\": \"\",",
      "            \"variable\": {}",
      "        },",
      "        \"received\": {",
      "            \"setParameter\": [",
      "                {",
      "                    \"@PARAM.commonResult\": {",
      "                        \"status\": \"@RES.${1:${TM_FILENAME_BASE}}.statusCode\",",
      "                        \"resultCode\": \"@RES.${1:TM_FILENAME_BASE}.body.resultCode\",",
      "                        \"resultDesc\": \"@RES.${1:TM_FILENAME_BASE}.body.resultDesc\"",
      "                    },",
      "                    \"criteria\": {",
      "                        \"action\": \"custom\",",
      "                        \"value\": \"'@RES.${1:${TM_FILENAME_BASE}}.statusCode' < 500\"",
      "                    }",
      "                },",
      "                {",
      "                    \"@PARAM.commonResult\": {",
      "                        \"status\": 500,",
      "                        \"resultCode\": \"50002\",",
      "                        \"resultDesc\": \"Connection timeout\",",
      "                        \"errorType\": \"common\"",
      "                    },",
      "                    \"criteria\": {",
      "                        \"action\": \"custom\",",
      "                        \"value\": \"'@RES.${1:${TM_FILENAME_BASE}}.statusCode' == 504 && '@RES.${1:${TM_FILENAME_BASE}}.appCodeError' == '50400' && '@RES.${1:${TM_FILENAME_BASE}}.appMessageError' == 'ETIMEOUT'\"",
      "                    }",
      "                },",
      "                {",
      "                    \"@PARAM.commonResult\": {",
      "                        \"status\": 500,",
      "                        \"resultCode\": \"50003\",",
      "                        \"resultDesc\": \"Connection error\",",
      "                        \"errorType\": \"common\"",
      "                    },",
      "                    \"criteria\": {",
      "                        \"action\": \"custom\",",
      "                        \"value\": \"'@RES.${1:${TM_FILENAME_BASE}}.statusCode' == 503 && '@RES.${1:${TM_FILENAME_BASE}}.appCodeError' == '50300' && '@RES.${1:${TM_FILENAME_BASE}}.appMessageError' == 'ECONNREFUSED'\"",
      "                    }",
      "                }",
      "            ],",
      "            \"contentType\": \"application/json\",",
      "            \"verify\": {",
      "                \"mandatory\": {",
      "                    \"body\": []",
      "                }",
      "            },",
      "            \"variable\": {",
      "                \"@VAR.commonResult\": \"@PARAM.commonResult\"",
      "            },",
      "            \"conditionResponse\": {",
      "                \"verifySuccess\": {",
      "                    \"stat\": \"@STAT.suc\",",
      "                    \"redirectStep\": \"#main\"",
      "                },",
      "                \"verifyError\": {",
      "                    \"verifyMandatory\": {",
      "                        \"stat\": \"@STAT.err\",",
      "                        \"redirectStep\": \"@TABLE.condition.cd_mapModelResponse.modelResponse\"",
      "                    },",
      "                    \"verifyConnection\": {",
      "                        \"connectionTimeout\": {",
      "                            \"stat\": \"@STAT.err\",",
      "                            \"redirectStep\": \"@TABLE.condition.cd_mapModelResponse.modelResponse\"",
      "                        },",
      "                        \"connectionError\": {",
      "                            \"stat\": \"@STAT.err\",",
      "                            \"redirectStep\": \"@TABLE.condition.cd_mapModelResponse.modelResponse\"",
      "                        }",
      "                    },",
      "                    \"else\": {",
      "                        \"stat\": \"@STAT.err\",",
      "                        \"redirectStep\": \"@TABLE.condition.cd_mapModelResponse.modelResponse\"",
      "                    }",
      "                }",
      "            }",
      "        }",
      "    }",
      "}",
      ""
    ],
    "description": "apim command"
  },
  "apim response format": {
    "prefix": "rf",
    "body": [
      "{",
      "    \"${1:${TM_FILENAME_BASE}}\": {",
      "        \"channel\": \"API\",",
      "        \"format\": \"application/json\",",
      "        \"header\": {},",
      "        \"body\": {",
      "            \"status\": \"@VAR.status\",",
      "            \"code\": \"@VAR.code\",",
      "            \"reason\": \"@VAR.reason\"",
      "        }",
      "    }",
      "}",
      ""
    ],
    "description": "apim response format"
  },
  "apim mapping response": {
    "prefix": "mr",
    "body": [
      "{",
      "    \"${1:${TM_FILENAME_BASE}}\": {",
      "        \"getStatus\": \"@TABLE.responseStatus.${2:20000_mappingStatus}\",",
      "        \"setFormat\": \"@TABLE.responseFormat.rf_${1}\",",
      "        \"stat\": \"@STAT.${3: returnedSuccess}\"",
      "    }",
      "}",
      ""
    ],
    "description": "apim mapping response"
  },
  "apim resource profile": {
    "prefix": "rp",
    "body": [
      "{",
      "    \"uri\": [",
      "        \"${1: authenEndpoint}\"",
      "    ],",
      "    \"resource\": \"myais\",",
      "    \"authenType\": \"${2:Oauth}\",",
      "    \"authenNode\": \"myais-BE\",",
      "    \"username\": \"\",",
      "    \"password\": \"\",",
      "    \"isSpecial\": false",
      "}",
      ""
    ],
    "description": "apim resource profile"
  },
  "apim resource token": {
    "prefix": "rt",
    "body": [
      "{",
      "    \"resource\": \"${1:authResource}\",",
      "    \"authenNode\": \"myais-BE\",",
      "    \"authenType\": \"Oauth\",",
      "    \"expireIn\": ${2:unix},",
      "    \"token\": \"Bearer ${3:jwtToken}\"",
      "}",
      ""
    ],
    "description": "apim resource token"
  }
}
